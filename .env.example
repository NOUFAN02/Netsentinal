# AbuseIPDB API key for threat intelligence IP enrichment
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Path to Suricata eve.json log file
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# SQLite Database path (defaults to netsentinel.db in project root)
NETSENTINEL_DB=netsentinel.db

# API server configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Dashboard server port
DASHBOARD_PORT=8080
