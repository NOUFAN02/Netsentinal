# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example

# SQLite Databases
*.db
*.sqlite
*.sqlite3

# Runtime logs & state
logs/*
!logs/.gitkeep
reports/output/*
