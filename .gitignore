.parser_state

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
